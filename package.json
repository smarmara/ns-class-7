{
  "name": "ns-class7-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Independent, unofficial study aid for the Nova Scotia Class 7 Learner's Licence knowledge test.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "content:quality": "tsx scripts/content-quality.ts",
    "mock:analyze": "tsx scripts/mock-analyze.ts",
    "sources:check": "tsx scripts/sources-check.ts",
    "sources:check:ci": "tsx scripts/sources-check.ts --ci",
    "sources:ingest": "tsx scripts/ingest-handbook.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm content:validate && pnpm sources:check:ci && pnpm test && pnpm test:e2e && pnpm build",
    "icons:generate": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
